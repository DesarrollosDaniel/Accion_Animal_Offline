{
  "name": "accion-animal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/check-test-environment.mjs",
    "build": "tsc -b && vite build --mode testing",
    "build:production": "node --env-file=.env.production.local scripts/production-environment.mjs && tsc -b && vite build --mode production --outDir dist-production && node --env-file=.env.production.local scripts/production-environment.mjs --mark",
    "prebuild": "node scripts/check-test-environment.mjs",
    "preview": "vite preview",
    "prepreview": "node scripts/check-test-environment.mjs",
    "start:local": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.server server/local-server.mjs",
    "prestart:local": "node scripts/check-test-environment.mjs",
    "local": "npm run build && npm run start:local",
    "start:production": "node --env-file=.env.production.local server/local-server.mjs",
    "local:production": "npm run build:production && npm run start:production",
    "typecheck": "tsc -b --pretty false",
    "check:environment": "node scripts/check-test-environment.mjs",
    "test:environment": "node --test scripts/test-environment.test.mjs",
    "db:push:test": "node scripts/push-test-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.43.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
